{
	admin off
}

:{$PORT:8080} {
	encode gzip

	# API + runtime config -> backend service (e.g. https://web-production-1234.up.railway.app)
	@backend path /api/* /app-config.js
	handle @backend {
		reverse_proxy {$BACKEND_URL} {
			header_up Host {upstream_hostport}
			flush_interval -1
		}
	}

	# React app: static files, SPA fallback to index.html
	handle {
		root * /srv
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
